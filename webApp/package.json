  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "jsdom": "^26.0.0",
    "playwright": "^1.63.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
