{
  "name": "notepad-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-pdf.mjs",
    "prebuild": "node scripts/prepare-pdf.mjs",
    "pretest:browser": "node scripts/prepare-pdf.mjs",
    "test:browser": "node scripts/editor-smoke.mjs",
    "test:ipad": "node scripts/ipad-images.mjs",
    "test:features": "node scripts/feature-audit.mjs",
